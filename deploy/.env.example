# Generate with: openssl rand -hex 32
PRESSREADER_SYNC_TOKEN=replace-with-a-long-random-token

# Six hours. The worker still skips editions it has already exported.
PRESSREADER_SYNC_INTERVAL_SECONDS=21600
PRESSREADER_SYNC_TIMEZONE=Europe/Lisbon
PRESSREADER_SYNC_LOCALE=en-US

# Use 127.0.0.1 behind a reverse proxy; use 0.0.0.0 for direct LAN/VPN access.
PRESSREADER_SYNC_BIND=0.0.0.0
LOG_LEVEL=INFO

# Optional recovery override if PressReader changes the publication menu markup:
# PRESSREADER_MORE_SELECTOR=button.your-selector
